{
  "manifest": 1,
  "id": "pets",
  "name": "Pets",
  "version": "0.0.1",
  "publisher": "hyperpane",
  "description": "A little pixel cat that naps on the header of the window you're working in and follows you to the next one. Four coats, three sizes; click it for a heart.",
  "icon": "icon.svg",
  "category": "Look",
  "license": "MIT",
  "homepage": "https://github.com/hyperpane/hp-pets",
  "engines": { "hyperpane": ">=0.2.0" },
  "permissions": ["canvas"],
  "client": { "main": "main.tsx" },
  "contributes": {
    "overlays": [{ "id": "pet", "title": "The cat on the active window" }],
    "settings": [
      {
        "id": "coat",
        "title": "Coat",
        "description": "The cat's colors: ginger, grey, black or cream.",
        "group": "The cat",
        "type": "enum",
        "default": "ginger",
        "options": [
          { "value": "ginger", "label": "Ginger" },
          { "value": "grey", "label": "Grey" },
          { "value": "black", "label": "Black" },
          { "value": "cream", "label": "Cream" }
        ]
      },
      {
        "id": "size",
        "title": "Size",
        "description": "How big the cat is next to the window. It still grows and shrinks with the canvas's zoom, and hides on a window narrower than itself.",
        "group": "The cat",
        "type": "enum",
        "default": "medium",
        "options": [
          { "value": "small", "label": "Small" },
          { "value": "medium", "label": "Medium" },
          { "value": "large", "label": "Large" }
        ]
      }
    ]
  },
  "signature": {
    "key": "ed25519:5LgmP9NjLnpvz48igrFekSqi+4k6gzaO8sNwlsgNKFc=",
    "sig": "qjAdj6vBq5nV7OeeA2nAaWy1uj/KbMVO+il16ZjOby0In+i8SdfDQe8OQCVHo8Tw5XAZ+k+mixwg3GpRov/SDA=="
  }
}
